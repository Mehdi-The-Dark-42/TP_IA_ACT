@startuml
title Diagnostic RIA - Flux applicatif

actor "Utilisateur" as User

partition "Interface" {
  rectangle "WelcomePage\n(Commencer le diagnostic)" as Welcome
  rectangle "FormPage\n(Champ: companyName, email, phone, sector,\nhasAI, aiTypes, dataTypes, userImpact,...)" as Form
  rectangle "ResultsPage\n(riskBadge, riskScore, recommendations,\nestimatedCost, timeline)" as Results
}

partition "Application" {
  component "AppState\n(store des champs du formulaire)" as State
  component "generateReport()\n(valide, collecte, construit rapport)" as Generator
  component "calculateRiskLevel()\n(calcul score & niveau)" as RiskEngine
}

User --> Welcome : clique "Commencer"
Welcome --> Form : affiche formulaire

User --> Form : renseigne champs
Form --> State : met à jour champs

User --> Form : clique "Générer le diagnostic"
Form --> Generator : appel generateReport()
Generator --> State : lit données
Generator -> RiskEngine : calculateRiskLevel(state)
RiskEngine --> Generator : {level, score}
Generator -> Results : prépare rendu (badge, score, reco, coûts, délai)
Results --> User : affiche rapport

User --> Results : clique "Nouveau diagnostic"
Results -> Generator : appelle resetApp()
Generator -> State : réinitialise champs
Generator -> Form : reset UI

@enduml